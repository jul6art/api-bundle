parameters:
    level: max
    phpVersion:
        min: 80500
        max: 80599
    paths:
        - Api
        - ApiBundle.php
        - Filter
        - State
        - DependencyInjection
        - Tests
        - rector.php
    treatPhpDocTypesAsCertain: false

    # Le niveau max dès le premier jour, et sans baseline : une brique extraite avec une
    # baseline arrive avec sa dette déjà tolérée, et personne ne la reprend ensuite.
